# build the control panel
#
# Cross-compiles from the build host's architecture instead of emulating the
# target, so a multi-arch build costs one native Go compile per architecture.
# Unlike the agent this keeps the blanket module download: the panel is what
# actually needs modernc.org/sqlite, and it embeds internal/panel/web.
FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS build
ARG TARGETARCH
ARG VERSION=dev
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=$TARGETARCH \
	go build -buildvcs=false -trimpath \
	-ldflags "-s -w -X xuanwu/internal/panel.Version=$VERSION" -o /panel ./cmd/panel

FROM alpine:3.22
RUN apk add --no-cache wget && mkdir -p /data
COPY --from=build /panel /usr/local/bin/panel
# Runs as root so a host bind-mounted ./data is writable regardless of its owner.
# The container is otherwise isolated (no host mounts beyond ./data, no caps,
# no docker socket).
EXPOSE 8088
ENTRYPOINT ["/usr/local/bin/panel"]
